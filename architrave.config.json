{
  "platform": "web",
  "stack": "react",
  "designSource": {
    "type": "storybook",
    "path": "web/.storybook",
    "url": "http://localhost:6006",
    "mcp": "http://localhost:6006/mcp",
    "spec": "docs/ui/tessera-admin-portal-ui-spec.md"
  },
  "designMap": "docs/ui/tessera-design-map.json",
  "knowledgePack": "web",
  "applyTo": [
    "web/**"
  ],
  "build": "npm --prefix web run build",
  "test": "npm --prefix web run test -- --pool=threads --maxWorkers=1",
  "backend": {
    "stack": "dotnet",
    "solution": "Tessera.slnx",
    "contracts": [
      "docs/tessera/r2/R2_PRODUCT_SPEC.md",
      "docs/tessera/r2/R2_API_CONTRACT.md",
      "docs/tessera/r2/R2_PRODUCT_ARCHITECTURE.md",
      "docs/tessera/r2/R2_DATA_MODEL.md",
      "docs/tessera/r2/REALTIME_VOICE.md",
      "docs/tessera/r2/REALTIME_VOICE_API_CONTRACT.md",
      "docs/tessera/r2/REALTIME_VOICE_DATA_MODEL.md",
      "docs/tessera/r2/REALTIME_VOICE_SECURITY_MODEL.md",
      "docs/tessera/r2/REALTIME_VOICE_TEST_MATRIX.md",
      "docs/tessera/r2/CHAT_MODEL.md",
      "docs/tessera/r2/MODEL_PROVIDER_MODEL.md",
      "docs/tessera/r2/ACCOUNT_MODEL.md",
      "docs/tessera/r2/PLUGIN_SDK.md",
      "docs/tessera/r2/CAPABILITY_RUNTIME.md",
      "docs/tessera/r2/JOB_MODEL.md",
      "docs/tessera/r2/JOB_SCHEDULER.md",
      "docs/tessera/r2/MEMORY_IN_CHAT.md",
      "docs/tessera/r2/ACTION_APPROVAL_UX.md",
      "docs/tessera/r2/R2_SECURITY_MODEL.md",
      "docs/tessera/r2/R2_TEST_MATRIX.md"
    ],
    "architectureDocs": [
      "docs/adr",
      "docs/architecture.md",
      "docs/specs"
    ],
    "applyTo": [
      "src/**",
      "tests/**"
    ],
    "build": "dotnet build Tessera.slnx",
    "test": "dotnet test Tessera.slnx"
  },
  "iac": {
    "kind": "mixed",
    "path": "deploy",
    "plan": "kubectl kustomize deploy/k8s >/tmp/tessera-k8s-rendered.yaml && test -s /tmp/tessera-k8s-rendered.yaml",
    "policy": "kubectl kustomize deploy/k8s >/tmp/tessera-k8s-rendered.yaml && kubeconform -summary /tmp/tessera-k8s-rendered.yaml",
    "applyTo": [
      "deploy/**"
    ]
  },
  "ops": {
    "kind": "homelab-mcp",
    "mode": "read-only",
    "mcpServer": "homelab",
    "purpose": [
      "runtime-health",
      "logs",
      "deployment-verification",
      "version-drift"
    ],
    "requiresApprovalFor": [
      "mutations",
      "reconcile",
      "restart",
      "secret-access",
      "network-change"
    ]
  },
  "learning": {
    "runArtifactsPath": ".architrave/runs",
    "repoProfilePath": ".architrave/learning/repo-profile.md",
    "lessonsPath": ".architrave/learning/repo-lessons.md",
    "capture": [
      "run-artifacts",
      "gate-results",
      "judge-verdicts",
      "runtime-evidence",
      "repo-profile",
      "lessons"
    ],
    "redactionPolicy": "no-secrets",
    "staleFactPolicy": "validate-before-use",
    "promotionPolicy": "approval-required",
    "promoteAfterOccurrences": 2,
    "promoteTargets": [
      "architrave.config.json",
      "AGENTS.md",
      ".github/instructions",
      "docs"
    ]
  }
}