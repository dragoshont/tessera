{
  "schema": "tessera.design-map.v1",
  "tokenSource": "web/src/index.css",
  "components": {
    "AppShell": {
      "story": "Shell/AppShell",
      "code": "web/src/components/shell/AppShell.tsx",
      "states": ["Member", "Admin", "Mobile", "Dark"]
    },
    "ActivityFeed": {
      "story": "Awareness/ActivityFeed",
      "code": "web/src/components/activity/ActivityFeed.tsx",
      "states": ["Default", "Loading", "Empty"]
    },
    "ConnectionDrawer": {
      "story": "Accounts/ConnectionDrawer",
      "code": "web/src/components/accounts/ConnectionDrawer.tsx",
      "states": ["Overview", "Activity", "Policy", "Error"]
    },
    "PendingWritesTable": {
      "story": "Action Required/PendingWritesTable",
      "code": "web/src/components/pending/PendingWritesTable.tsx",
      "states": ["Populated", "Loading", "Empty", "Deciding"]
    },
    "FollowUpWorkspace": {
      "story": "Continuity/FollowUpWorkspace",
      "code": "web/src/components/continuity/FollowUpWorkspace.tsx",
      "reuses": ["AppShell", "ActivityFeed", "ConnectionDrawer", "PendingWritesTable"],
      "states": ["Attention", "Conflict", "Tracked", "Completed", "Loading", "Empty", "Error"]
    },
    "ChatWorkspace": {
      "story": "Product/ChatWorkspace",
      "code": "web/src/components/chat/ChatWorkspace.tsx",
      "reuses": ["AppShell"],
      "states": ["Empty", "Configured", "Loading", "Error", "ConfigurationRequired"]
    },
    "SetupCenter": {
      "story": "Product/SetupCenter",
      "code": "web/src/components/product/SetupCenter.tsx",
      "reuses": ["AppShell"],
      "states": ["ReadyToConnect", "Connecting", "Error"]
    },
    "IntegrationSearchPanel": {
      "story": "Product/IntegrationSearchPanel",
      "code": "web/src/components/product/IntegrationSearchPanel.tsx",
      "reuses": ["AppShell"],
      "states": ["Results", "Searching", "Empty", "SourceDegraded"]
    },
    "ActionApprovalCard": {
      "story": "Product/ActionApprovalCard",
      "code": "web/src/components/product/R2ProductComponents.tsx",
      "reuses": ["PendingWritesTable", "ActivityFeed"],
      "states": ["Proposed", "Running", "Verified", "ReconciliationRequired", "Failed", "Canceled"]
    },
    "JobRunTimeline": {
      "story": "Product/ActionApprovalCard/JobWaitingForApproval",
      "code": "web/src/components/product/R2ProductComponents.tsx",
      "reuses": ["ActionApprovalCard", "ActivityFeed"],
      "states": ["Queued", "Running", "WaitingForApproval", "Succeeded", "Failed", "ReconciliationRequired"]
    }
  },
  "semanticTokens": {
    "surface": "--surface",
    "card": "--card",
    "text": "--foreground",
    "muted": "--muted-foreground",
    "border": "--border",
    "accent": "--accent",
    "current": "--health-live",
    "candidate": "--health-expiring"
  },
  "constraints": [
    "Continuity/FollowUpWorkspace is the signed-off component contract; app routes compose it without parallel visual state.",
    "Conflict uses accent plus text and icon; red remains reserved for true errors.",
    "No continuity state is communicated by color alone.",
    "Desktop tables reflow to labeled list rows on narrow viewports.",
    "No chat or external execution control appears in continuity surfaces."
  ]
}